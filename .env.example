# Production template for PromptPulse
# Copy this to a real .env file in your local environment or deployment dashboard.
# Never commit real secrets.

# Core application
ENVIRONMENT=production
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=10080
FRONTEND_URL=https://your-vercel-app.vercel.app

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:replace-with-password@db.your-project.supabase.co:5432/postgres

# AI providers
AI_PROVIDER=gemini
GEMINI_API_KEY=replace-with-gemini-api-key
OPENAI_API_KEY=replace-with-openai-key-if-used

# Redis / queue (optional)
REDIS_URL=redis://default:replace-with-redis-password@your-upstash-redis-url:6379

# Supabase storage
STORAGE_TYPE=supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=slides

# App media/public asset URL
PUBLIC_MEDIA_BASE_URL=https://your-render-backend.onrender.com/media

# Meta / Instagram Graph API
META_APP_ID=replace-with-meta-app-id
META_APP_SECRET=replace-with-meta-app-secret
INSTAGRAM_REDIRECT_URI=https://your-vercel-app.vercel.app/settings/instagram/callback
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# Frontend public API URL
NEXT_PUBLIC_API_URL=https://your-render-backend.onrender.com/api

# Optional local-only overrides for development
# ENVIRONMENT=development
# FRONTEND_URL=http://localhost:3000
# DATABASE_URL=sqlite:///./promptpulse.db
# PUBLIC_MEDIA_BASE_URL=http://localhost:8000/media
# REDIS_URL=redis://localhost:6379/0
